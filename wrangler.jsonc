// Serve only the exported portal pages; each mini app deploys as its own site from standalone/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-arcade",
  "compatibility_date": "2026-10-04",
  "account_id": "201949bff4aff6b9a9b0725859b9cdae",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
