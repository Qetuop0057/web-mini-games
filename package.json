{
  "name": "web-mini-games",
  "version": "1.0.0",
  "description": "A browser mini-game arcade built with Next.js.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "next build --webpack",
    "build:lemonade": "node standalone/lemonade-stand/build.mjs",
    "deploy:arcade": "npm run build:cloudflare && wrangler deploy --config wrangler.jsonc",
    "deploy:lemonade": "npm run build:lemonade && wrangler deploy --config standalone/lemonade-stand/wrangler.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qetuop0057/web-mini-games.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Qetuop0057/web-mini-games/issues"
  },
  "homepage": "https://github.com/Qetuop0057/web-mini-games#readme",
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.147.0"
  },
  "private": true
}
